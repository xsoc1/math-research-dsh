{
  "name": "math-research-dsh",
  "version": "2.0.1",
  "description": "Long-term mathematics research guidance for DeepSeek Harness: literature and annotatable tools, reusable research experience, session continuity, and optional Lean verification, synced from four parent plugins.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "skills",
    "README_EN.md",
    "docs/dsh-store-contract.md"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xsoc1/math-research-dsh.git"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "cordis",
    "plugin",
    "skill",
    "mathematics",
    "research",
    "proof",
    "lean"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.7-rc.2 <0.2.0",
      "dshReleases": {
        "0.1.7-alpha.2": "unknown",
        "0.1.7-rc.1": "unknown",
        "0.1.7-rc.2": "compatible"
      },
      "dshOperations": {
        "0.1.7-alpha.2": {
          "install": "unknown",
          "start": "unknown",
          "uninstall": "unknown",
          "rollback": "unknown"
        },
        "0.1.7-rc.1": {
          "install": "unknown",
          "start": "unknown",
          "uninstall": "unknown",
          "rollback": "unknown"
        },
        "0.1.7-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        }
      },
      "profiles": [
        "web",
        "headless"
      ]
    },
    "marketplace": {
      "profiles": [
        "web",
        "headless"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": false
    }
  }
}
